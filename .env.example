NODE_ENV=development
HOST="127.0.0.1"
PORT=4000
DATABASE_URL="mariadb://brainvault:GENERATED_DATABASE_PASSWORD@127.0.0.1:3306/brainvault"
# Optional. If set, server startup and npm run db:init can create the database/user with admin privileges.
# MARIADB_ADMIN_URL="mariadb://root:your-root-password@127.0.0.1:3306"
# Exact MariaDB account hosts. Wildcards such as % and _ are rejected.
DB_USER_HOSTS="localhost,127.0.0.1,::1"
AUTO_BOOTSTRAP_DATABASE=true
# npm run dev always opens a private/incognito browser window; normal-profile launch is disabled.
DATABASE_CONNECTION_LIMIT=10
# npm run env:init replaces both placeholders with separate cryptographically random values.
JWT_SECRET="GENERATED_BY_NPM_RUN_ENV_INIT"
JWT_EXPIRES_IN="7d"
MFA_ENCRYPTION_KEY="GENERATED_BY_NPM_RUN_ENV_INIT"
WEBAUTHN_RP_NAME="BrainVault"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:4000"
CORS_ORIGIN="http://localhost:4000,http://127.0.0.1:4000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
# Registration defaults to enabled outside production and disabled in production when omitted.
# REGISTRATION_ENABLED=false
# Internal project documentation is not served over HTTP unless explicitly enabled.
SERVE_INTERNAL_DOCS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_MAX=20
AUTH_LOGIN_ACCOUNT_WINDOW_MS=3600000
AUTH_LOGIN_ACCOUNT_MAX=30
AUTH_MFA_IP_WINDOW_MS=900000
AUTH_MFA_IP_MAX=15
AUTH_MFA_ACCOUNT_WINDOW_MS=3600000
AUTH_MFA_ACCOUNT_MAX=20
AUTH_MFA_SETUP_WINDOW_MS=900000
AUTH_MFA_SETUP_MAX=10
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_REGISTER_MAX=5
# Set the exact number of trusted reverse-proxy hops. Never use an unrestricted trust setting.
TRUST_PROXY_HOPS=0

# OpenGraph bookmark preview requests are fetched by the server with strict time and response-size limits.
BOOKMARK_FETCH_TIMEOUT_MS=8000
BOOKMARK_FETCH_MAX_BYTES=524288

# Attachment files are stored outside the public web root and downloaded through an authenticated route.
ATTACHMENT_UPLOAD_DIR="uploads"
MAX_ATTACHMENT_SIZE_MB=25

# Maximum exported/imported backup archive size accepted by the restore endpoint. Increase for larger vaults.
DATA_TRANSFER_MAX_SIZE_MB=4096
