NODE_ENV=development
HOST="127.0.0.1"
PORT=4000
# Remote production database hosts must enable connector TLS with ?ssl=true.
DATABASE_URL="mariadb://brainvault:GENERATED_DATABASE_PASSWORD@127.0.0.1:3306/brainvault"
# Optional. If set, server startup and npm run db:init can create the database/user with admin privileges.
# MARIADB_ADMIN_URL="mariadb://root:your-root-password@127.0.0.1:3306"
# Remote production admin database hosts must also use ?ssl=true.
# Exact MariaDB account hosts. Wildcards such as % and _ are rejected.
DB_USER_HOSTS="localhost,127.0.0.1,::1"
AUTO_BOOTSTRAP_DATABASE=true
# npm run dev always opens a private/incognito browser window; normal-profile launch is disabled.
DATABASE_CONNECTION_LIMIT=10
# npm run env:init replaces both placeholders with separate cryptographically random values.
JWT_SECRET="GENERATED_BY_NPM_RUN_ENV_INIT"
# Session JWT lifetimes must be between 5 minutes and 24 hours. The default is 12 hours.
JWT_EXPIRES_IN="12h"
# Compatibility bearer tokens default to disabled in production. Browser sessions use the HttpOnly cookie.
# AUTH_ALLOW_BEARER_TOKENS=false
MFA_ENCRYPTION_KEY="GENERATED_BY_NPM_RUN_ENV_INIT"
WEBAUTHN_RP_NAME="BrainVault"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:4000"
CORS_ORIGIN="http://localhost:4000,http://127.0.0.1:4000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
# Canonical browser-facing origin. In proxy and Posh-ACME modes this must be HTTPS and listed above.
PUBLIC_ORIGIN="http://localhost:4000"
# "off" serves HTTP in development/test only. Production requires "proxy" or "posh-acme".
# "proxy" trusts an explicitly addressed TLS reverse proxy; "posh-acme" serves HTTPS directly.
HTTPS_MODE=off
# Posh-ACME mode accepts either its certificate order folder or the FullChainFile path.
# The default private key is cert.key beside fullchain.cer. On Windows, forward slashes are easiest in .env files.
# POSH_ACME_CERT_PATH="C:/Users/you/AppData/Local/Posh-ACME/acme-v02.api.letsencrypt.org/example.com"
# Optional override when cert.key is stored elsewhere.
# POSH_ACME_KEY_PATH="C:/secure/example.com-cert.key"
# Defaults to true only in proxy mode. Set false to return HTTP 426 instead of redirecting proxy-side HTTP.
# HTTPS_REDIRECT=true
# Keep /health reachable over the private backend HTTP listener in proxy mode.
HTTPS_HEALTHCHECK_BYPASS=true
# Registration defaults to enabled outside production and disabled in production when omitted.
# REGISTRATION_ENABLED=false
# Internal project documentation is not served over HTTP unless explicitly enabled.
SERVE_INTERNAL_DOCS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Username-based page sharing is additionally limited per authenticated account and source IP.
COLLABORATION_SHARE_WINDOW_MS=3600000
COLLABORATION_SHARE_ACCOUNT_MAX=30
COLLABORATION_SHARE_IP_MAX=60
# Navigation-order persistence is a write-heavy preference mutation and has its own per-account ceiling.
NAVIGATION_ORDER_WINDOW_MS=60000
NAVIGATION_ORDER_ACCOUNT_MAX=12
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_MAX=20
AUTH_LOGIN_ACCOUNT_WINDOW_MS=21600000
AUTH_LOGIN_ACCOUNT_MAX=30
# Persisted account backoff starts after this many password failures and doubles up to the maximum.
# Failed-attempt state decays by one after each AUTH_LOGIN_FAILURE_RESET_MS idle interval.
AUTH_LOGIN_LOCK_THRESHOLD=8
AUTH_LOGIN_LOCK_BASE_MS=30000
AUTH_LOGIN_LOCK_MAX_MS=900000
AUTH_LOGIN_FAILURE_RESET_MS=86400000
AUTH_MFA_IP_WINDOW_MS=900000
AUTH_MFA_IP_MAX=15
AUTH_MFA_ACCOUNT_WINDOW_MS=3600000
AUTH_MFA_ACCOUNT_MAX=20
AUTH_MFA_SETUP_WINDOW_MS=900000
AUTH_MFA_SETUP_MAX=10
# Username-less passkey ceremonies have separate issuance and verification ceilings.
AUTH_PASSKEY_OPTIONS_IP_WINDOW_MS=900000
AUTH_PASSKEY_OPTIONS_IP_MAX=30
AUTH_PASSKEY_VERIFY_IP_WINDOW_MS=900000
AUTH_PASSKEY_VERIFY_IP_MAX=15
# Accept only the current TOTP step by default. Set to 1 only when clock-skew compatibility is required.
MFA_TOTP_WINDOW_STEPS=0
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_REGISTER_MAX=5
# Process-wide registration ceiling that complements the per-IP limit.
AUTH_REGISTER_GLOBAL_MAX=20
# In proxy mode, trust only the exact proxy IP or the narrowest practical CIDR.
# Only loopback is accepted as a named range; use explicit proxy IPs or narrow CIDRs for other peers.
# Catch-all /0 CIDRs are rejected. Numeric hop trust is intentionally disabled and must remain 0.
TRUST_PROXY_ADDRESSES=""
TRUST_PROXY_HOPS=0

# OpenGraph bookmark preview requests are user-rate-limited and fetched with strict time and response-size limits.
BOOKMARK_PREVIEW_WINDOW_MS=60000
BOOKMARK_PREVIEW_MAX=12
BOOKMARK_FETCH_TIMEOUT_MS=8000
BOOKMARK_FETCH_MAX_BYTES=524288
# Server-side OpenGraph fetching is disabled unless trusted hosts are explicitly listed here.
# A listed hostname also permits its subdomains; each redirect is revalidated against this allowlist.
BOOKMARK_FETCH_ALLOWED_HOSTS=""
# Comma-separated outbound ports permitted for allowlisted bookmark preview hosts.
BOOKMARK_FETCH_ALLOWED_PORTS="80,443"

# Attachment files are stored outside the public web root, screened by filename/MIME/signature policy,
# and downloaded through an authenticated route with forced download disposition.
ATTACHMENT_UPLOAD_DIR="uploads"
# Startup removes stale temporary upload files older than this many milliseconds.
ATTACHMENT_TEMP_MAX_AGE_MS=86400000
MAX_ATTACHMENT_SIZE_MB=25
# Uploaded custom icons are retained as immutable files so old page references keep working.
# Bound both total bytes and file count per account to prevent persistent disk/inode exhaustion.
CUSTOM_ICON_STORAGE_MAX_MB=64
CUSTOM_ICON_STORAGE_MAX_FILES=2048
# Maximum committed attachment bytes per account. Keep this below the dedicated volume capacity.
ATTACHMENT_STORAGE_MAX_MB=2048
# Attachment upload admission is enforced per authenticated account before multipart bytes are accepted.
ATTACHMENT_UPLOAD_WINDOW_MS=60000
ATTACHMENT_UPLOAD_MAX=12
# Maximum concurrent attachment uploads per application process; each account is limited to one active upload.
ATTACHMENT_UPLOAD_MAX_CONCURRENT=4

# Maximum exported/imported backup archive size. Increase only with matching disk capacity and operational controls.
DATA_TRANSFER_MAX_SIZE_MB=1024
# Maximum JSON manifest size buffered and parsed during export/import.
DATA_TRANSFER_MAX_MANIFEST_SIZE_MB=16
# Complete-data exports are additionally limited per authenticated user.
DATA_EXPORT_WINDOW_MS=3600000
DATA_EXPORT_MAX=20
# Imports are limited before multipart bytes are accepted and only a small number may run concurrently.
DATA_IMPORT_WINDOW_MS=3600000
DATA_IMPORT_MAX=3
DATA_IMPORT_MAX_CONCURRENT=2

# Server-side workspace snapshots reuse the complete backup format but stay private on disk.
# Both a count and total-byte quota are enforced per account under a database row lock.
SNAPSHOT_MAX_COUNT=20
SNAPSHOT_STORAGE_MAX_MB=4096
