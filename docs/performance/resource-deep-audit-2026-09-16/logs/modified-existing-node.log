                `INSERT INTO blocks (id, page_id, parent_block_id, type, markdown, html_cache, checked, sort_order, metadata)
                 VALUES (?, ?, ?, 'ATTACHMENT', ?, ?, 0, ?, ?)`,
                [
                  id,
                  pageId,
                  body.parentBlockId,
                  originalName,
                  renderBlockHtml("ATTACHMENT", originalName, false, metadata),
                  createSortOrder,
                  JSON.stringify(metadata)
