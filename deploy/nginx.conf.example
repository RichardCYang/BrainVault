# Place this map in the http {} context.
# Explicitly omit query strings, referrers, cookies, authorization and WebSocket
# subprotocols (which carry short-lived collaboration and measurement tickets) from access logs.
log_format brainvault_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent';
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# One public NGINX ingress shares these zones across its workers, independently
# of application restarts. BrainVault currently requires one app process per DB.
# Empty keys exclude static assets and health checks. Tune rates/bursts locally;
# multiple ingress hosts need shared limits.
map $uri $brainvault_api_key {
    default "";
    ~^/api/ $binary_remote_addr;
}
map $uri $brainvault_auth_key {
    default "";
    ~^/api/(auth|mfa)/ $binary_remote_addr;
}
limit_req_zone $brainvault_api_key zone=brainvault_api:10m rate=10r/s;
limit_req_zone $brainvault_auth_key zone=brainvault_auth:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name notes.example.com;
    access_log /var/log/nginx/brainvault.access.log brainvault_safe;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name notes.example.com;
    access_log /var/log/nginx/brainvault.access.log brainvault_safe;

    ssl_certificate     /etc/letsencrypt/live/notes.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;

    location / {
        limit_req zone=brainvault_api burst=60 nodelay;
        limit_req zone=brainvault_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # Original client TCP_INFO, in microseconds. Enable
        # VPN_TRUST_PROXY_TCP_INFO only after these headers are configured.
        # Always overwrite incoming values. With real_ip rewriting, use the
        # original transport peer ($realip_remote_addr), not a rewritten IP.
        proxy_set_header X-BrainVault-TCP-Peer-IP   $remote_addr;
        proxy_set_header X-BrainVault-TCP-RTT-Us    $tcpinfo_rtt;
        proxy_set_header X-BrainVault-TCP-RTTVar-Us $tcpinfo_rttvar;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
